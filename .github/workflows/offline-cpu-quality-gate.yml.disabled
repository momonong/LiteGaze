# Disabled on 2026-08-05: local quality gates are the source of truth for the
# current experiment workflow. Rename this file back to `.yml` to re-enable it.
name: Offline CPU quality gate

on:
  pull_request:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: offline-cpu-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  offline-cpu:
    name: Python 3.12 / no Torch / no network
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: requirements-quality-gate.txt

      - name: Install CPU-only quality-gate dependencies
        run: python -m pip install --disable-pip-version-check -r requirements-quality-gate.txt

      - name: Verify Torch and CUDA packages are absent
        run: >-
          python -c "import importlib.util;
          assert importlib.util.find_spec('torch') is None,
          'The offline quality gate must not install Torch'"

      - name: Compile changed validation surfaces
        run: >-
          python -m compileall -q
          web/__init__.py
          core/gaze_core/calibration_regression.py
          core/gaze_core/inference.py
          core/gaze_core/model_registry.py
          core/gaze_core/motion_experiment.py
          core/gaze_core/motion_robustness.py
          core/gaze_core/session_independence.py
          core/gaze_core/sample_store.py
          core/gaze_core/torch_runtime.py
          core/gaze_core/training.py
          scripts/audit_gaze_motion_coverage.py
          scripts/audit_gaze_session_independence.py
          scripts/benchmark_gaze_inference.py
          scripts/import_offline_calibration.py
          scripts/run_gaze_motion_experiment.py
          scripts/run_offline_quality_gate.py
          scripts/test_app_factory.py
          scripts/test_gaze_benchmark.py
          scripts/test_gaze_calibration_regression.py
          scripts/test_gaze_motion_experiment.py
          scripts/test_gaze_motion_robustness.py
          scripts/test_gaze_session_independence.py
          scripts/test_gaze_torch_runtime.py
          scripts/test_adaptive_stepper.py
          scripts/test_cognitive_inspector.py
          scripts/test_fusion_routes.py
          web/routes/demo.py
          web/routes/gaze.py

      - name: Check browser calibration syntax
        run: node --check web/static/gaze_page.js

      - name: Lint changed validation surfaces
        run: >-
          python -m ruff check --select E4,E7,E9,F,I,UP
          web/__init__.py
          core/gaze_core/calibration_regression.py
          core/gaze_core/inference.py
          core/gaze_core/model_registry.py
          core/gaze_core/motion_experiment.py
          core/gaze_core/motion_robustness.py
          core/gaze_core/session_independence.py
          core/gaze_core/sample_store.py
          core/gaze_core/torch_runtime.py
          core/gaze_core/training.py
          scripts/audit_gaze_motion_coverage.py
          scripts/audit_gaze_session_independence.py
          scripts/benchmark_gaze_inference.py
          scripts/import_offline_calibration.py
          scripts/run_gaze_motion_experiment.py
          scripts/run_offline_quality_gate.py
          scripts/test_app_factory.py
          scripts/test_gaze_benchmark.py
          scripts/test_gaze_calibration_regression.py
          scripts/test_gaze_motion_experiment.py
          scripts/test_gaze_motion_robustness.py
          scripts/test_gaze_session_independence.py
          scripts/test_gaze_torch_runtime.py
          scripts/test_adaptive_stepper.py
          scripts/test_cognitive_inspector.py
          scripts/test_fusion_routes.py
          web/routes/demo.py
          web/routes/gaze.py

      - name: Run offline CPU quality gate
        run: python -X utf8 -m scripts.run_offline_quality_gate --timeout-seconds 180
