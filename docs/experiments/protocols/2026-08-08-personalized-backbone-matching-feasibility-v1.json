      "prev_zipf_frequency",
      "subtoken_count",
      "causal_surprisal",
      "prev_causal_surprisal"
    ],
    "ridge_alpha": 1.0,
    "outer_holdout": {
      "groups": "complete_Text_ID",
      "folds": 5,
      "seed": 20260808
    },
    "participant_holdout": "leave_one_participant_out_inside_every_outer_text_fold",
    "fit_rows": "participants_other_than_the_target_participant_and_Text_ID_outside_the_outer_evaluation_fold",
    "calibration_rows": "target_participant_and_Text_ID_outside_the_outer_evaluation_fold",
    "evaluation_rows": "target_participant_and_Text_ID_inside_the_outer_evaluation_fold",
    "required_leakage_checks": {
