      "budgets": [5, 10, 20, 40, 80, "all"],
      "primary_budget": 10,
      "estimated_primary_words_from_corpus_median": 960
    },
    "selection_rule": {
      "primary": "Select Pythia only when the 95 percent paired bootstrap interval of per-calibration-text Spearman differences is strictly above zero; otherwise abstain to GPT-2.",
      "calibration_bootstrap_samples": 2000,
      "default_on_uncertainty": "gpt2",
      "secondary_unconstrained_selector": "calibration_mean_argmax",
      "secondary_oracle": "evaluation_argmax_not_deployable"
    },
    "evaluation_metric": "Spearman_rho_between_predicted_and_observed_log1p_total_reading_time",
    "aggregation": {
      "cell": "participant_by_outer_fold",
      "participant": "mean_across_outer_folds",
      "fold": "mean_across_participants",
      "participant_bootstrap_samples": 10000,
      "participant_bootstrap_seed": 20260908
    }
  },
  "decision_gate": {
