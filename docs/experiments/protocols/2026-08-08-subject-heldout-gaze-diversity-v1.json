    "unigaze_exclusion_reason": "The production unigaze_b16_joint checkpoint was trained on a joint gaze dataset configuration that includes MPIIGaze, so its MPIIGaze score would not be an independent comparison."
  },
  "splits": {
    "outer_protocol": "15-fold leave-one-subject-out",
    "outer_test_subject_for_fold_i": "subjects[i]",
