    "balance_policy": "Use exactly the official 3000-row evaluation list for every subject in every role; no subject contributes more rows than another.",
    "excluded_inputs": [
      "question-answer datasets",
      "LexiGaze participant-study data",
      "OneStop, GECO, and PROVO outcomes",
      "legacy EAI teacher pseudo-labels",
      "legacy EAI checkpoints",
      "UniGaze joint checkpoint"
