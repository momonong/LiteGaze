  "status": "frozen_before_model_execution",
  "objective": "Measure whether a small eye-image plus head-pose model trained on balanced multi-person data learns gaze information that generalizes to entirely unseen people, using nested subject holdouts and without changing the production webcam model.",
  "claim_boundary": {
    "public_dataset_engineering_evidence_only": true,
    "real_lexigaze_webcam_generalization_claimed": false,
    "production_accuracy_improvement_claimed": false,
    "cognitive_or_english_ability_claimed": false,
    "future_cross_dataset_and_real_capture_confirmation_required": true
  },
  "data": {
    "dataset": "MPIIGaze",
    "local_root": "data/eai/MPIIGaze",
    "license": "CC BY-NC-SA 4.0",
    "evaluation_subset": "Evaluation Subset/sample list for eye image",
    "normalized_data": "Data/Normalized",
    "subjects": [
      "p00",
      "p01",
      "p02",
      "p03",
      "p04",
      "p05",
      "p06",
      "p07",
      "p08",
      "p09",
      "p10",
      "p11",
      "p12",
      "p13",
      "p14"
