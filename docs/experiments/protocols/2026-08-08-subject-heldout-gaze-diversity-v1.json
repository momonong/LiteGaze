    "participant_overlap_allowed": false
  },
  "candidate": {
    "name": "EyePoseTinyCNN-v1",
    "mode": "research_only",
    "architecture": [
      "Conv2d(1,32,kernel=5,stride=2,padding=2), GroupNorm(8,32), SiLU",
      "Conv2d(32,64,kernel=3,stride=2,padding=1), GroupNorm(8,64), SiLU",
      "Conv2d(64,96,kernel=3,stride=2,padding=1), GroupNorm(8,96), SiLU",
      "AdaptiveAvgPool2d(1), concatenate standardized pose(2)",
      "Linear(98,64), SiLU, Dropout(0.1), Linear(64,2)"
    ],
    "initialization": "PyTorch seeded default initialization",
    "loss": {
      "name": "SmoothL1Loss",
      "beta_radians": 0.05
    },
    "optimizer": {
      "name": "AdamW",
      "learning_rate": 0.001,
      "weight_decay": 0.0001
    },
    "training": {
      "batch_size": 512,
      "max_epochs": 40,
      "early_stopping_patience": 6,
      "early_stopping_min_delta_degrees": 0.01,
      "gradient_norm_clip": 1.0,
      "automatic_mixed_precision": false,
      "tf32_allowed": false,
      "augmentation": "none",
      "best_epoch_metric": "inner-validation mean angular error",
      "test_evaluation_timing": "once after restoring the validation-selected checkpoint"
    }
  },
  "baselines": {
    "constant_train_mean": "Normalize the mean outer-training 3D gaze vector and use it for every held-out row.",
    "pose_only_ridge": {
