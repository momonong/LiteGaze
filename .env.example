# Path where Hugging Face weights are cached.
# Note: For Windows, you can use "D:/hf_models". For Linux/macOS, use "/home/ubuntu/.cache/huggingface" or leave empty to use system default.
# The backend will automatically sanitize Windows-style paths (like D:/) on non-Windows platforms to avoid dummy directory creation.
HF_HOME=

# Required Hugging Face Token (if applicable)
HF_TOKEN=

# Required for Google AI Studio API (Inspector analyses, summaries)
GEMINI_API_KEY=

# Model variant for Google AI Studio
MODEL_NAME="gemma-4-26b-a4b-it"

# Optional stable secret for `run.py --tunnel` (minimum 32 UTF-8 bytes).
# If omitted, run.py generates a new ephemeral secret for each tunnel process.
# LEXIGAZE_TUNNEL_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Public-tunnel resource budgets. Local mode keeps its existing 500 MB limit.
# LEXIGAZE_TUNNEL_MAX_UPLOAD_MB=64
# LEXIGAZE_TUNNEL_MUTATIONS_PER_MINUTE=300
# LEXIGAZE_TUNNEL_PREDICTIONS_PER_MINUTE=900
# LEXIGAZE_TUNNEL_EXPENSIVE_PER_MINUTE=12
# LEXIGAZE_TUNNEL_EXPENSIVE_CONCURRENCY=1
# LEXIGAZE_TUNNEL_AUTH_ATTEMPTS_PER_MINUTE=10
# LEXIGAZE_TUNNEL_SESSION_TTL_SECONDS=28800
