# Path where Hugging Face weights are cached.
# Note: For Windows, you can use "D:/hf_models". For Linux/macOS, use "/home/ubuntu/.cache/huggingface" or leave empty to use system default.
# The backend will automatically sanitize Windows-style paths (like D:/) on non-Windows platforms to avoid dummy directory creation.
HF_HOME=

# Required Hugging Face Token (if applicable)
HF_TOKEN=

# Required for Google AI Studio API (Inspector analyses, summaries)
GEMINI_API_KEY=

# Model variant for Google AI Studio
MODEL_NAME="gemma-4-26b-a4b-it"

# Optional process-wide CUDA matmul acceleration. Keep disabled in the shared
# Flask process; enable only for a dedicated gaze worker or after validating
# every CUDA model in that process.
LEXIGAZE_ENABLE_PROCESS_WIDE_TF32=0

# Participant study. Leave these values unset for local dry runs. Real pilot
# enrollment stays locked until every value is present and the versioned
# protocol is independently approved/exempt and marked approved_for_pilot.
LEXIGAZE_STUDY_MODE=dry_run
LEXIGAZE_PUBLIC_STUDY_MODE=0
LEXIGAZE_ETHICS_STATUS=
LEXIGAZE_ETHICS_REFERENCE=
LEXIGAZE_INVESTIGATOR_NAME=
LEXIGAZE_INVESTIGATOR_EMAIL=
LEXIGAZE_PARTICIPANT_RIGHTS_CONTACT=
LEXIGAZE_RESEARCHER_API_KEY=
# Generate at least 32 random characters; never commit the real value.
LEXIGAZE_ADAPTIVE_SIGNING_KEY=
LEXIGAZE_EXTERNAL_ANCHOR_ID=
LEXIGAZE_EXTERNAL_ANCHOR_AUTHORIZED=0
LEXIGAZE_NETWORK_PROCESSOR=
LEXIGAZE_NETWORK_PROCESSOR_APPROVED=0
# Confirm tunnel/dashboard full-body capture and local inspection are disabled.
LEXIGAZE_REQUEST_BODY_LOGGING_DISABLED=0
LEXIGAZE_STORAGE_ENCRYPTED=0
LEXIGAZE_PUBLIC_BASE_URL=
LEXIGAZE_DATA_LOCATION=
LEXIGAZE_DATA_RETENTION_DAYS=
# Must be between 1 and 24. Successful/failed calibration normally purges sooner.
LEXIGAZE_RAW_FRAME_RETENTION_HOURS=
